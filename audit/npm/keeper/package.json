{
  "name": "@bondline/keeper",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/keeper.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json",
    "scenario": "tsx scripts/local-scenario.ts",
    "fetch-opening": "tsx scripts/fetch-opening-rounds.ts",
    "test:mirror": "tsx scripts/test-live-mirror.ts"
  },
  "dependencies": {
    "@bondline/shared": "0.1.0",
    "dotenv": "^16",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
