{
  "name": "@bondline/agents",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/agents.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json",
    "verify-decision": "tsx scripts/verify-decision.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@bondline/shared": "0.1.0",
    "dotenv": "^16",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
