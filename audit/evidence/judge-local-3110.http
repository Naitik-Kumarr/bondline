":[[\"$\",\"li\",\"Short history: 72 trading days (23 Jun - 2 Oct 2026). Overlapping covers share the same price moves, so claims cluster: they are not independent samples.\",{\"children\":\"Short history: 72 trading days (23 Jun - 2 Oct 2026). Overlapping covers share the same price moves, so claims cluster: they are not independent samples.\"}],[\"$\",\"li\",\"In-sample: σ in the model price was estimated from closes in the same window (shared/src/volatility.json), so the model premium had the window's volatility in hand.\",{\"children\":\"In-sample: σ in the model price was estimated from closes in the same window (shared/src/volatility.json), so the model premium had the window's volatility in hand.\"}],[\"$\",\"li\",\"The agents trade in reality; the backtest holds a fixed basket for the hold, so it tests the rules' worst-case exposure at the open, not the agents' behaviour.\",{\"children\":\"The agents trade in reality; the backtest holds a fixed basket for the hold, so it tests the rules' worst-case exposure at the open, not the agents' behaviour.\"}],[\"$\",\"li\",\"All 17 claims settled between 2026-07-23 and 2026-07-28: the window held one sharp drawdown, so the claims are one event seen from 17 different opening days, not 17 independent events.\",{\"children\":\"All 17 claims settled between 2026-07-23 and 2026-07-28: the window held one sharp drawdown, so the claims are one event seen from 17 different opening days, not 17 independent events.\"}],[\"$\",\"li\",\"Annualised returns scale a 3-month window to a year; they are arithmetic on this window, not a forecast, and are large because 1% to 4% premiums are charged on 30-day covers that mostly expired without a claim.\",{\"children\":\"Annualised returns scale a 3-month window to a year; they are arithmetic on this window, not a forecast, and are large because 1% to 4% premiums are charged on 30-day covers that mostly expired without a claim.\"}],[\"$\",\"li\",\"Chainlink posts a round when the price moves about 0.5% (only 12 of the 1408 moves between TSLA rounds used here and 12 of the 845 between AMZN rounds were smaller) and none while the market is closed: the longest gap between rounds is 77.8 h for TSLA and 77.1 h for AMZN, and 14 and 14 gaps are longer than the 25-hour max price age. So a settle at 'the first round past the limit' can overshoot by up to one deviation step even without a gap, and by the whole move across a closed market.\",{\"children\":\"Chainlink posts a round when the price moves about 0.5% (only 12 of the 1408 moves between TSLA rounds used here and 12 of the 845 between AMZN rounds were smaller) and none while the market is closed: the longest gap between rounds is 77.8 h for TSLA and 77.1 h for AMZN, and 14 and 14 gaps are longer than the 25-hour max price age. So a settle at 'the first round past the limit' can overshoot by up to one deviation step even without a gap, and by the whole move across a closed market.\"}],[\"$\",\"li\",\"Hypothetical covers on real prices: none of these covers was sold. Testnet, unaudited. A capped, fully backed protection bond, not regulated insurance.\",{\"children\":\"Hypothetical covers on real prices: none of these covers was sold. Testnet, unaudited. A capped, fully backed protection bond, not regulated insurance.\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"4c:[\"$\",\"p\",null,{\"className\":\"mt-4 text-[13px] text-ink-3\",\"children\":[\"Read from docs/data/backtest.json\",\", generated 2026-10-04\",\". Re-run it with\",\" \",[\"$\",\"span\",null,{\"className\":\"num\",\"children\":\"npx tsx scripts/backtest.ts\"}],\".\"]}]\n4d:[\"$\",\"dd\",null,{\"className\":\"mt-2 text-[12.5px] leading-snug text-ink-3\",\"children\":\"handler calls; those whose precondition fails return early\"}]\n4e:[\"$\",\"div\",\"Invariants\",{\"className\":\"border-b border-r border-line p-5 sm:p-6\",\"children\":[[\"$\",\"dt\",null,{\"className\":\"text-[13px] text-ink-3\",\"children\":\"Invariants\"}],[\"$\",\"