:[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer text-[14px] text-ink-2\",\"children\":[\"Caveats \",[\"$\",\"span\",null,{\"className\":\"num text-ink-3\",\"children\":[\"(\",7,\")\"]},\"$3a6\",\"$418\",1]]},\"$3a6\",\"$417\",1],[\"$\",\"ul\",null,{\"className\":\"mt-3 list-disc space-y-2 pl-5 text-[13.5px] leading-relaxed text-ink-2\",\"children\":[[\"$\",\"li\",\"Short history: 72 trading days (23 Jun - 2 Oct 2026). Overlapping covers share the same price moves, so claims cluster: they are not independent samples.\",{\"children\":\"Short history: 72 trading days (23 Jun - 2 Oct 2026). Overlapping covers share the same price moves, so claims cluster: they are not independent samples.\"},\"$3a6\",\"$41a\",0],[\"$\",\"li\",\"In-sample: σ in the model price was estimated from closes in the same window (shared/src/volatility.json), so the model premium had the window's volatility in hand.\",{\"children\":\"In-sample: σ in the model price was estimated from closes in the same window (shared/src/volatility.json), so the model premium had the window's volatility in hand.\"},\"$3a6\",\"$41b\",0],[\"$\",\"li\",\"The agents trade in reality; the backtest holds a fixed basket for the hold, so it tests the rules' worst-case exposure at the open, not the agents' behaviour.\",{\"children\":\"The agents trade in reality; the backtest holds a fixed basket for the hold, so it tests the rules' worst-case exposure at the open, not the agents' behaviour.\"},\"$3a6\",\"$41c\",0],[\"$\",\"li\",\"All 17 claims settled between 2026-07-23 and 2026-07-28: the window held one sharp drawdown, so the claims are one event seen from 17 different opening days, not 17 independent events.\",{\"children\":\"All 17 claims settled between 2026-07-23 and 2026-07-28: the window held one sharp drawdown, so the claims are one event seen from 17 different opening days, not 17 independent events.\"},\"$3a6\",\"$41d\",0],[\"$\",\"li\",\"Annualised returns scale a 3-month window to a year; they are arithmetic on this window, not a forecast, and are large because 1% to 4% premiums are charged on 30-day covers that mostly expired without a claim.\",{\"children\":\"Annualised returns scale a 3-month window to a year; they are arithmetic on this window, not a forecast, and are large because 1% to 4% premiums are charged on 30-day covers that mostly expired without a claim.\"},\"$3a6\",\"$41e\",0],[\"$\",\"li\",\"Chainlink posts a round when the price moves about 0.5% (only 12 of the 1408 moves between TSLA rounds used here and 12 of the 845 between AMZN rounds were smaller) and none while the market is closed: the longest gap between rounds is 77.8 h for TSLA and 77.1 h for AMZN, and 14 and 14 gaps are longer than the 25-hour max price age. So a settle at 'the first round past the limit' can overshoot by up to one deviation step even without a gap, and by the whole move across a closed market.\",{\"children\":\"Chainlink posts a round when the price moves about 0.5% (only 12 of the 1408 moves between TSLA rounds used here and 12 of the 845 between AMZN rounds were smaller) and none while the market is closed: the longest gap between rounds is 77.8 h for TSLA and 77.1 h for AMZN, and 14 and 14 gaps are longer than the 25-hour max price age. So a settle at 'the first round past the limit' can overshoot by up to one deviation step even without a gap, and by the whole move across a closed market.\"},\"$3a6\",\"$41f\",0],\"$L420\"]},\"$3a6\",\"$419\",1]]},\"$3a6\",\"$416\",1],\"$L421\"]},\"$3b0\",\"$3b1\",1]\n"])</script><script>self.__next_f.push([1,"3a5:[\"$\",\"section\",null,{\"className\":\"relative py-10 sm:py-14 scroll-mt-24\",\"aria-labelledby\":\"backtest-title\",\"id\":\"backtest\",\"children\":\"$3af\"},\"$3a7\",\"$3ae\",1]\n422:D\"$423\"\n422:D\"$424\"\n42a:D\"$42b\"\n42d:D\"$42e\"\n42d:[\"$\",\"$L1a1\",null,{\"className\":\"\",\"children\":[[\"$\",\"p\",null,{\"className\":\"eyebrow mb-4\",\"children\":\"Proofs\"},\"$42e\",\"$430\",1],[\"$\",\"h2\",null,{\