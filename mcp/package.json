  },
  "dependencies": {
    "@bondline/sdk": "0.1.0",
    "@bondline/shared": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "tsx": "4.23.15",
    "viem": "2.57.2",
    "zod": "3.25.76"
  }
